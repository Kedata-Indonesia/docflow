{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "paths": {
      "@docs-editor/core": ["./packages/core/src"],
      "@docs-editor/core/*": ["./packages/core/src/*"],
      "@docs-editor/layout-engine": ["./packages/layout-engine/src"],
      "@docs-editor/layout-engine/*": ["./packages/layout-engine/src/*"],
      "@docs-editor/plugins": ["./packages/plugins/src"],
      "@docs-editor/plugins/*": ["./packages/plugins/src/*"],
      "@docs-editor/vue": ["./packages/vue/src"],
      "@docs-editor/vue/*": ["./packages/vue/src/*"],
      "@docs-editor/element": ["./packages/element/src"],
      "@docs-editor/element/*": ["./packages/element/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", "e2e"]
}
