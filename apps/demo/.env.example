# Demo app environment
#
# Vite exposes only env vars prefixed with VITE_ to the client.
#
# Same-domain deployment (default for local Docker Compose):
#   Leave VITE_API_BASE_URL empty so API calls stay same-origin (/api/*).
#   Leave VITE_COLLAB_WEBSOCKET_URL empty to default to /collab.
#
# Separate-domain deployment (e.g. Dokploy):
#   FE: https://dev-docflow.kedata.cloud
#   BE: https://dev-docflow-server.kedata.cloud
#   VITE_API_BASE_URL=https://dev-docflow-server.kedata.cloud
#   VITE_COLLAB_WEBSOCKET_URL=wss://dev-docflow-server.kedata.cloud/collab

# Backend API base URL (empty = same-origin)
VITE_API_BASE_URL=

# WebSocket collaboration server URL.
# Empty defaults to same-origin /collab.
# For separate-domain deployments, set the full backend WebSocket URL:
#   VITE_COLLAB_WEBSOCKET_URL=wss://dev-docflow-server.kedata.cloud/collab
VITE_COLLAB_WEBSOCKET_URL=

# Port for the demo Vite dev server and preview server.
DEMO_PORT=5173
