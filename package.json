{
  "name": "@kedata-indonesia/docflow-root",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test:unit": "pnpm -r run test:unit",
    "test:coverage": "pnpm -r run test:coverage",
    "coverage:summary": "node scripts/coverage-summary.mjs",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs",
    "lint": "eslint . --max-warnings 0 --report-unused-disable-directives",
    "test:e2e": "playwright test",
    "docs:api": "node scripts/generate-api-docs.mjs",
    "docs:api:check": "node scripts/generate-api-docs.mjs --check",
    "dev": "pnpm --filter @kedata-indonesia/docflow-playground dev",
    "dev:source": "pnpm --filter @kedata-indonesia/docflow-playground dev:source",
    "playground:restore": "node scripts/restore-playground.mjs",
    "visual:capture": "VISUAL_OUT=visual-runs/current playwright test --project=visual",
    "visual:diff": "node scripts/visual-diff.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tsup": "^9.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.10",
    "vitest": "^2.1.3",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
