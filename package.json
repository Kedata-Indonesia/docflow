{
  "name": "@docs-editor/root",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test:unit": "pnpm -r run test:unit",
    "lint": "eslint . --ext .ts,.vue",
    "dev": "pnpm --filter @docs-editor/demo dev",
    "test:e2e": "playwright test",
    "test:visual": "percy exec -- playwright test"
  },
  "devDependencies": {
    "@percy/cli": "^1.32.2",
    "@percy/playwright": "^1.1.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.30.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
