{
  "name": "@kedata-indonesia/docflow-vue",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --project tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@kedata-indonesia/docflow-core": "workspace:*",
    "@kedata-indonesia/docflow-layout-engine": "workspace:*",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tiptap/core": "^2.11.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.5.2",
    "happy-dom": "^20.10.6",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "vue-tsc": "^2.1.6"
  }
}
