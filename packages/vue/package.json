{
  "name": "@kedata-indonesia/docflow-vue",
  "license": "Apache-2.0",
  "version": "0.0.129",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --project tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@kedata-indonesia/docflow-core": "workspace:*",
    "@kedata-indonesia/docflow-layout-engine": "workspace:*",
    "@kedata-indonesia/docflow-plugins": "workspace:*",
    "lucide-vue-next": "^1.0.0"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.32.0",
    "prosemirror-model": "^1.25.12",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tiptap/core": "^3.32.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "happy-dom": "^21.0.3",
    "postcss": "^8.5.15",
    "prosemirror-model": "^1.25.12",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=20"
  }
}
