{
  "name": "@kedata-indonesia/docflow-export",
  "license": "Apache-2.0",
  "version": "0.0.1",
  "description": "DOCX / Markdown / HTML export helpers for DocFlow.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kedata-Indonesia/docflow.git",
    "directory": "packages/export"
  },
  "homepage": "https://github.com/Kedata-Indonesia/docflow#readme",
  "bugs": {
    "url": "https://github.com/Kedata-Indonesia/docflow/issues"
  },
  "author": "PT Kedata Indonesia",
  "keywords": [
    "editor",
    "export",
    "docx",
    "markdown",
    "html"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "prosemirror-markdown": "^1.13.5",
    "prosemirror-model": "^1.25.11"
  },
  "devDependencies": {
    "happy-dom": "^20.10.6",
    "tsup": "^8.3.0",
    "typescript": "^7.0.2",
    "vitest": "^2.1.3"
  }
}
