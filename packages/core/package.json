    "tiptap-pagination-plus": "3.1.0",
    "y-webrtc": "^10.3.0",
    "y-websocket": "^2.0.4 || ^3.1.0",
    "yjs": "^13.6.33",
    "@tiptap/y-tiptap": "^3.0.10"
  },
  "devDependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-collaboration": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/y-tiptap": "^3.0.10",
    "@vitest/coverage-v8": "^2.1.3",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.3",
    "tiptap-pagination-plus": "3.1.0",
    "tsup": "^9.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "y-webrtc": "^10.3.0",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
