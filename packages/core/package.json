{
  "name": "@kedata-indonesia/docflow-core",
  "license": "Apache-2.0",
  "version": "0.0.82",
  "description": "Headless DocFlow editor factory and plugin system.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kedata-Indonesia/docflow.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Kedata-Indonesia/docflow#readme",
  "bugs": {
    "url": "https://github.com/Kedata-Indonesia/docflow/issues"
  },
  "author": "PT Kedata Indonesia",
  "keywords": [
    "editor",
    "rich-text",
    "tiptap",
    "prosemirror",
    "document",
    "pagination",
    "collaboration"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai/index.js",
      "require": "./dist/ai/index.cjs"
    },
    "./collab": {
      "types": "./dist/collab/index.d.ts",
      "import": "./dist/collab/index.js",
      "require": "./dist/collab/index.cjs"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@tiptap/core": "^2.11.0",
    "@tiptap/extension-collaboration": "^2.27.2",
    "@tiptap/extension-collaboration-cursor": "^2.26.2",
    "@tiptap/extension-text-style": "^2.11.0",
    "@tiptap/pm": "^2.11.0",
    "@tiptap/starter-kit": "^2.11.0",
    "tiptap-pagination-plus": "3.1.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.20"
  },
  "peerDependencies": {
    "@tiptap/core": "^2.11.0",
    "@tiptap/extension-collaboration": "^2.27.2",
    "@tiptap/extension-collaboration-cursor": "^2.26.2",
    "@tiptap/extension-text-style": "^2.11.0",
    "@tiptap/starter-kit": "^2.11.0",
    "tiptap-pagination-plus": "3.1.0",
    "y-webrtc": "^10.3.0",
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.20"
  },
  "peerDependenciesMeta": {
    "@tiptap/extension-collaboration": {
      "optional": true
    },
    "@tiptap/extension-collaboration-cursor": {
      "optional": true
    },
    "y-webrtc": {
      "optional": true
    },
    "y-websocket": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.10.6",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
