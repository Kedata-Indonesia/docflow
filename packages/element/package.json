{
  "name": "@kedata-indonesia/docflow-element",
  "license": "Apache-2.0",
  "version": "0.0.127",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsup src/index.ts --format cjs && vue-tsc --project tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@kedata-indonesia/docflow-core": "workspace:*",
    "@kedata-indonesia/docflow-vue": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^2.1.9",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.3",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=20"
  }
}
