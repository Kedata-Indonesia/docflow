{
  "name": "@kedata-indonesia/docflow-element",
  "license": "Apache-2.0",
  "version": "0.0.82",
  "description": "Web Component (<docs-editor>) wrapper for DocFlow.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kedata-Indonesia/docflow.git",
    "directory": "packages/element"
  },
  "homepage": "https://github.com/Kedata-Indonesia/docflow#readme",
  "bugs": {
    "url": "https://github.com/Kedata-Indonesia/docflow/issues"
  },
  "author": "PT Kedata Indonesia",
  "keywords": [
    "editor",
    "web-component",
    "custom-element",
    "docs-editor",
    "rich-text"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "vite build && tsup src/index.ts --format cjs && vue-tsc --project tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@kedata-indonesia/docflow-core": "workspace:*",
    "@kedata-indonesia/docflow-vue": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.3",
    "vue-tsc": "^2.1.6"
  }
}
