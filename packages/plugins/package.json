{
  "name": "@kedata-indonesia/docflow-plugins",
  "license": "Apache-2.0",
  "version": "0.0.84",
  "description": "Built-in plugins for DocFlow (table, image, link, citations, …).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kedata-Indonesia/docflow.git",
    "directory": "packages/plugins"
  },
  "homepage": "https://github.com/Kedata-Indonesia/docflow#readme",
  "bugs": {
    "url": "https://github.com/Kedata-Indonesia/docflow/issues"
  },
  "author": "PT Kedata Indonesia",
  "keywords": [
    "editor",
    "tiptap",
    "prosemirror",
    "plugins",
    "table",
    "image",
    "citations"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./citations": {
      "types": "./dist/citations.d.ts",
      "import": "./dist/citations.js",
      "require": "./dist/citations.cjs"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist",
    "CSL-LICENSES.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/citations.ts --format esm,cjs --dts --no-splitting",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@kedata-indonesia/docflow-core": "workspace:*",
    "@tiptap/extension-color": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "citeproc": "^2.4.63",
    "tiptap-markdown": "0.8.10"
  },
  "peerDependencies": {
    "@tiptap/core": "^2.11.0",
    "@tiptap/extension-color": "^2.11.0",
    "@tiptap/extension-highlight": "^2.11.0",
    "@tiptap/extension-image": "^2.11.0",
    "@tiptap/extension-link": "^2.11.0",
    "@tiptap/extension-placeholder": "^2.11.0",
    "@tiptap/extension-strike": "^2.11.0",
    "@tiptap/extension-table": "^2.11.0",
    "@tiptap/extension-table-cell": "^2.11.0",
    "@tiptap/extension-table-header": "^2.11.0",
    "@tiptap/extension-table-row": "^2.11.0",
    "@tiptap/extension-task-item": "^2.11.0",
    "@tiptap/extension-task-list": "^2.11.0",
    "@tiptap/extension-text-align": "^2.11.0",
    "@tiptap/extension-underline": "^2.11.0"
  },
  "peerDependenciesMeta": {
    "@tiptap/extension-image": {
      "optional": true
    },
    "@tiptap/extension-link": {
      "optional": true
    },
    "@tiptap/extension-placeholder": {
      "optional": true
    },
    "@tiptap/extension-strike": {
      "optional": true
    },
    "@tiptap/extension-table": {
      "optional": true
    },
    "@tiptap/extension-table-cell": {
      "optional": true
    },
    "@tiptap/extension-table-header": {
      "optional": true
    },
    "@tiptap/extension-table-row": {
      "optional": true
    },
    "@tiptap/extension-task-item": {
      "optional": true
    },
    "@tiptap/extension-task-list": {
      "optional": true
    },
    "@tiptap/extension-text-align": {
      "optional": true
    },
    "@tiptap/extension-underline": {
      "optional": true
    },
    "@tiptap/extension-color": {
      "optional": true
    },
    "@tiptap/extension-highlight": {
      "optional": true
    }
  },
  "devDependencies": {
    "happy-dom": "^20.10.6",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "yjs": "^13.6.20"
  }
}
