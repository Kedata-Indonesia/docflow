{
  "name": "@kedata-indonesia/docflow-layout-engine",
  "license": "Apache-2.0",
  "version": "0.0.81",
  "description": "Page split and pagination engine for DocFlow.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kedata-Indonesia/docflow.git",
    "directory": "packages/layout-engine"
  },
  "homepage": "https://github.com/Kedata-Indonesia/docflow#readme",
  "bugs": {
    "url": "https://github.com/Kedata-Indonesia/docflow/issues"
  },
  "author": "PT Kedata Indonesia",
  "keywords": [
    "editor",
    "pagination",
    "page-break",
    "layout",
    "prosemirror"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@kedata-indonesia/docflow-core": "workspace:*",
    "@tiptap/pm": "^3.31.3"
  },
  "devDependencies": {
    "happy-dom": "^20.10.6",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
